# Air Quality Monitoring System - Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# ThingSpeak API Configuration
THINGSPEAK_CHANNEL_ID=2863798
THINGSPEAK_READ_API_KEY=RIXYDDDMXDBX9ALI
THINGSPEAK_WRITE_API_KEY=PV514C353A367A3J
THINGSPEAK_USER_API_KEY=your_user_api_key_here
THINGSPEAK_TIMEOUT=10000

# Database Configuration (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=air_quality_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Security Configuration
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m

# Data Processing Configuration
CACHE_TTL=300
MAX_DATA_POINTS=10000
DATA_REFRESH_INTERVAL=60000
MAX_REQUESTS_PER_MINUTE=100
ENABLE_RATE_LIMITING=true

# Arduino/Hardware Configuration (if applicable)
ARDUINO_PORT=COM3
ARDUINO_BAUD_RATE=9600
HARDWARE_TIMEOUT=5000

# External Services
WEATHER_API_KEY=your_weather_api_key
NOTIFICATION_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# Default Data Sources
DEFAULT_CSV_PATH=public/data/default-data.csv

# Development/Debug Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_MOCK_DATA=false
