<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ThingSpeak Channel Information</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/thingspeak-info.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-cloud-drizzle-fill me-2"></i>
                Air Quality Monitor
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/dashboard">Dashboard</a>
                <a class="nav-link active" href="/thingspeak-info">ThingSpeak Info</a>
                <button class="btn btn-outline-light btn-sm" id="toggleTheme">
                    <i class="bi bi-moon-fill"></i>
                </button>
            </div>
        </div>
    </nav>

    <main class="container-fluid">
        <div class="row">
            <!-- Header -->
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center my-4">
                    <div>
                        <h1 class="mb-1">ThingSpeak Channel Information</h1>
                        <div class="d-flex align-items-center">
                            <span class="status-indicator disconnected" id="status-indicator"></span>
                            <span class="text-muted" id="status-text">Connecting...</span>
                        </div>
                    </div>
                    <div>
                        <button class="btn btn-primary" id="refreshChannelData">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>
                </div>
            </div>

            <!-- Channel Details -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Channel Details</h5>
                        <span class="badge bg-secondary" id="channel-status-badge">Loading...</span>
                    </div>
                    <div class="card-body channel-details-container">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Field Mapping -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Field Mapping</h5>
                    </div>
                    <div class="card-body field-mapping-container">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Live Data & Visualizations -->
            <div class="col-lg-4">
                <!-- Latest Readings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Latest Readings</h5>
                    </div>
                    <div class="card-body latest-data-container">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- API Usage -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">API Usage</h5>
                    </div>
                    <div class="card-body api-usage-container">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CSV Update -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Data Export</h5>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-outline-primary btn-sm w-100" id="csvUpdateBtn">
                            <i class="bi bi-download"></i> Update Local CSV
                        </button>
                        <div class="mt-2 text-center" id="csvUpdateStatus">
                            <small class="text-muted">Ready to update</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Visualizations -->
            <div class="col-12">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Live Sensor Radar</h5>
                            </div>
                            <div class="card-body">
                                <div class="viz-container">
                                    <canvas id="liveRadarChart" width="400" height="300"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">AQI Gauge</h5>
                            </div>
                            <div class="card-body">
                                <div class="viz-container">
                                    <canvas id="liveAQIGauge" width="400" height="300"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast Container -->
    <div id="toast-container" class="position-fixed bottom-0 end-0 p-3"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/thingspeak-helper.js"></script>
    <script src="/js/thingspeak-info.js"></script>
</body>
</html>
