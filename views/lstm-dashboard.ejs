<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LSTM Air Quality Prediction Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Visualization libraries -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>
    
    <!-- Theme utility - load before other scripts -->
    <script src="/js/theme.js"></script>
</head>
<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3" href="/">
            <i class="bi bi-cloud-haze2"></i> Air Quality Monitor
        </a>
        <div class="d-flex align-items-center text-white me-2">
            <span class="status-indicator disconnected" id="status-indicator"></span>
            <small id="status-text">Initializing...</small>
        </div>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="d-flex">
            <button id="toggleTheme" class="btn btn-link text-white" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Toggle dark mode">
                <i class="bi bi-moon-fill"></i>
            </button>
        </div>
    </header>
    
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <div class="position-sticky pt-3">
                    <h6 class="sidebar-heading px-3">Navigation</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/lstm">
                                <i class="bi bi-cpu me-1"></i> LSTM Predictions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/config">
                                <i class="bi bi-gear me-1"></i> Configuration
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/status">
                                <i class="bi bi-info-circle me-1"></i> System Status
                            </a>
                        </li>
                    </ul>
                    
                    <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
                        <span>Prediction Options</span>
                    </h6>
                    <ul class="nav flex-column mb-2">
                        <li class="nav-item">
                            <a class="nav-link lstm-option-link active" href="#" data-option="24h">
                                <i class="bi bi-clock me-1"></i> 24-Hour Forecast
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lstm-option-link" href="#" data-option="48h">
                                <i class="bi bi-clock-history me-1"></i> 48-Hour Forecast
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link lstm-option-link" href="#" data-option="7d">
                                <i class="bi bi-calendar-week me-1"></i> 7-Day Forecast
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <!-- Header section with title and action buttons -->
                <div id="lstm-header-section" class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"><i class="bi bi-cpu"></i> LSTM Air Quality Predictions</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="refreshPredictions()">
                                <i class="bi bi-arrow-clockwise"></i> Refresh
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="trainModelBtn">
                                <i class="bi bi-lightning"></i> Train Model
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" id="modelInfoBtn">
                                <i class="bi bi-info-circle"></i> Model Info
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success" id="exportForecastBtn">
                                <i class="bi bi-download"></i> Export Forecast
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Model Status Card -->                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-info-circle"></i> LSTM Model Status</h5>
                                <div id="model-status-container" class="d-flex justify-content-between align-items-center">
                                    <div id="model-status-badge">
                                        <span id="lstm-status" class="badge bg-secondary">
                                            <div class="spinner-border spinner-border-sm text-light" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            Checking model status...
                                        </span>
                                    </div>
                                    <div>
                                        <span class="text-muted small">Last trained: <span id="last-trained-date">Unknown</span></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LSTM Prediction Charts -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card viz-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-graph-up"></i> Air Quality Predictions
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary active parameter-btn" data-param="pm25">PM2.5</button>
                                    <button type="button" class="btn btn-outline-secondary parameter-btn" data-param="pm10">PM10</button>
                                    <button type="button" class="btn btn-outline-secondary parameter-btn" data-param="temperature">Temperature</button>
                                    <button type="button" class="btn btn-outline-secondary parameter-btn" data-param="humidity">Humidity</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="viz-container" style="height: 400px;">
                                    <canvas id="lstmPredictionChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Prediction Accuracy -->                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card viz-card">
                            <div class="card-header">
                                <i class="bi bi-calculator"></i> Model Performance
                            </div>
                            <div class="card-body">
                                <div id="model-metrics-container">
                                    <form id="evaluation-form" class="mb-3">
                                        <div class="row g-2 align-items-center">
                                            <div class="col-auto">
                                                <label for="evaluation-days" class="col-form-label">Test Period:</label>
                                            </div>
                                            <div class="col-auto">
                                                <select class="form-select form-select-sm" id="evaluation-days">
                                                    <option value="3">Last 3 days</option>
                                                    <option value="7" selected>Last 7 days</option>
                                                    <option value="14">Last 14 days</option>
                                                    <option value="30">Last 30 days</option>
                                                </select>
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-sm btn-primary" id="evaluate-btn" onclick="evaluateModel()">
                                                    Evaluate Model
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                    
                                    <div id="evaluation-status" class="text-muted small mb-2">
                                        Click evaluate to check model performance
                                    </div>
                                    
                                    <div id="evaluation-chart-container" class="d-none mt-3">
                                        <h6 class="text-center mb-2">Model Error Metrics</h6>
                                        <canvas id="evaluation-chart" height="200"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card viz-card">
                            <div class="card-header">
                                <i class="bi bi-clipboard-data"></i> Prediction Details
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Time</th>
                                                <th>PM2.5</th>
                                                <th>PM10</th>
                                                <th>Temperature</th>
                                                <th>Humidity</th>
                                            </tr>
                                        </thead>
                                        <tbody id="prediction-table-body">
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                        <span class="visually-hidden">Loading...</span>
                                                    </div>
                                                    <span class="ms-2">Loading prediction data...</span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Training Section -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="bi bi-lightning"></i> LSTM Model Training
                            </div>
                            <div class="card-body">
                                <form id="lstm-training-form">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="trainingDays" class="form-label">Training Data Period (days)</label>
                                            <input type="number" class="form-control" id="trainingDays" min="7" max="365" value="30">
                                            <div class="form-text">Number of days of historical data to use for training</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="epochs" class="form-label">Training Epochs</label>
                                            <input type="number" class="form-control" id="epochs" min="10" max="200" value="50">
                                            <div class="form-text">Number of training iterations</div>
                                        </div>
                                    </div>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label for="batchSize" class="form-label">Batch Size</label>
                                            <input type="number" class="form-control" id="batchSize" min="8" max="128" step="8" value="32">
                                            <div class="form-text">Number of samples per gradient update</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label for="validationSplit" class="form-label">Validation Split</label>
                                            <select class="form-select" id="validationSplit">
                                                <option value="0.1">10%</option>
                                                <option value="0.2" selected>20%</option>
                                                <option value="0.3">30%</option>
                                            </select>
                                            <div class="form-text">Percentage of data used for validation</div>
                                        </div>
                                    </div>
                                    
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                        <button type="button" class="btn btn-primary" id="startTrainingBtn">
                                            <i class="bi bi-play-fill"></i> Start Training
                                        </button>
                                    </div>
                                </form>
                                
                                <!-- Training Progress -->
                                <div id="training-progress-container" class="mt-4 d-none">
                                    <h5 class="mb-3">Training Progress</h5>
                                    <div class="progress mb-3" style="height: 20px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated" id="training-progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                                    </div>
                                    <div id="training-status-message" class="text-center text-muted"></div>
                                    
                                    <div class="row mt-4">
                                        <div class="col-md-6">
                                            <canvas id="trainingLossChart" height="250"></canvas>
                                        </div>
                                        <div class="col-md-6">
                                            <div id="training-metrics" class="table-responsive">
                                                <table class="table table-sm">
                                                    <tbody>
                                                        <tr>
                                                            <td>Current Epoch</td>
                                                            <td id="current-epoch">-</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Training Loss</td>
                                                            <td id="training-loss">-</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Validation Loss</td>
                                                            <td id="validation-loss">-</td>
                                                        </tr>
                                                        <tr>
                                                            <td>Elapsed Time</td>
                                                            <td id="elapsed-time">-</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Toast container for notifications -->
                <div id="toast-container" class="position-fixed bottom-0 end-0 p-3"></div>
            </main>
        </div>
    </div>

    <!-- Bootstrap core JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    
    <!-- Custom JavaScript for LSTM Dashboard -->
    <script src="/js/lstm-dashboard.js"></script>
    <script>
        // Initialize tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
    </script>
</body>
</html>
