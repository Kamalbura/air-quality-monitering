{
  "name": "air-quality-monitoring",
  "version": "2.0.0",  "description": "Real-time air quality monitoring with ThingSpeak integration and advanced analytics",
  "main": "startup.js",
  "scripts": {
    "start": "node startup.js",
    "dev": "nodemon startup.js",
    "server": "node server-main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "node setup.js",
    "clean": "node clean-repo.js",
    "validate": "node validate.js",
    "verify": "node verify-system.js",
    "install-deps": "npm install",
    "check-health": "curl -f http://localhost:3000/api/health || exit 1",
    "health": "node -e \"require('axios').get('http://localhost:3000/health').then(r => console.log('✅ Server healthy:', r.data)).catch(e => console.log('❌ Server unhealthy:', e.message))\"",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "logs:clear": "rimraf logs/*.log",
    "startup:check": "node -e \"const s = require('./startup.js'); new s().runAllChecks()\"",
    "env:setup": "cp .env.example .env",
    "diagnostics": "node -e \"require('axios').get('http://localhost:3000/api/diagnostics').then(r => console.log(JSON.stringify(r.data, null, 2))).catch(e => console.log('❌ Diagnostics failed:', e.message))\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "air-quality",
    "thingspeak",
    "monitoring",
    "iot",
    "environmental",
    "analytics",
    "real-time",
    "websocket"
  ],
  "author": "Air Quality Monitoring Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/air-quality-monitoring.git"
  }
}
